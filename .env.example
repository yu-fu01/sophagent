# --- auth -------------------------------------------------------------------
# JWT signing secret; if unset, one is generated and persisted in /data/.secret
SOPHAGENT_SECRET=

# Bootstrap admin account (created on first start when no users exist).
# If ADMIN_PASSWORD is unset a random password is generated and logged once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- model providers ----------------------------------------------------------
# RECOMMENDED: put a providers.yaml in the data dir instead (see README).
# Inline JSON below only works when passed without shell sourcing (e.g. via
# docker compose `environment:`); `source .env` strips the double quotes.
# api_key supports $ENV_NAME indirection.
SOPHAGENT_PROVIDERS={"providers":{"openai":{"api_mode":"openai","api_key":"$OPENAI_API_KEY","context_limit":128000},"anthropic":{"api_mode":"anthropic","api_key":"$ANTHROPIC_API_KEY","context_limit":200000}}}
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- optional ------------------------------------------------------------------
# Use a pre-built image from CI instead of local build (docker compose pull && up -d)
# SOPHAGENT_IMAGE=docker.fuyucloud.top/sophagent:dev-<sha>
# Better web_search backend (otherwise DuckDuckGo HTML fallback is used)
TAVILY_API_KEY=

# --- speech-to-text (Feishu / IM voice) --------------------------------------
# 默认走 Sophnet EasyLLM ASR（Fun-ASR）。留空 BASE_URL 即可，与聊天 provider 共用 API Key。
# SOPHAGENT_STT_API_KEY=           # 不填则自动用 providers.yaml 里 sophnet provider 的 key
# SOPHAGENT_STT_BASE_URL=          # 留空 = https://www.sophnet.com/.../easyllms/speechtotext
# SOPHAGENT_STT_MODEL=Fun-ASR

# --- IM: Weixin (personal WeChat via iLink Bot API) -------------------------
# 需先用 hermes gateway setup 或手动扫码获取 account_id + token。
# 凭证也可持久化到 data/weixin/accounts/<account_id>.json（仅 account_id 时自动加载 token）。
# SOPHAGENT_WEIXIN_ACCOUNT_ID=
# SOPHAGENT_WEIXIN_TOKEN=
# SOPHAGENT_WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com
# SOPHAGENT_WEIXIN_ALLOWED_USER_IDS=   # 可选白名单；空=仅靠配对码控制访问
# SOPHAGENT_WEIXIN_DM_POLICY=pairing   # pairing | allowlist | disabled
# SOPHAGENT_WEIXIN_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
# SOPHAGENT_WEIXIN_SPLIT_MULTILINE=false

# --- IM: DingTalk (Stream + markdown / optional AI Card) --------------------
# 钉钉开放平台创建机器人应用，消息接收选 Stream 模式。
# SOPHAGENT_DINGTALK_CLIENT_ID=
# SOPHAGENT_DINGTALK_CLIENT_SECRET=
# SOPHAGENT_DINGTALK_CARD_TEMPLATE_ID=   # 选填；留空则用 markdown 回复
# SOPHAGENT_DINGTALK_ROBOT_CODE=         # 可选，默认等于 Client ID
# SOPHAGENT_DINGTALK_ALLOWED_USER_IDS=
# SOPHAGENT_DINGTALK_DM_POLICY=pairing
# SOPHAGENT_DINGTALK_REQUIRE_MENTION=true
# SOPHAGENT_DINGTALK_ALLOWED_CHAT_IDS=      # 群聊白名单 conversation_id
# SOPHAGENT_DINGTALK_FREE_RESPONSE_CHATS=   # 免 @ 群聊
# SOPHAGENT_DINGTALK_MENTION_PATTERNS=      # 唤醒词正则，每行一个或 JSON 数组
# SOPHAGENT_DINGTALK_WEBHOOK_URL=           # 静态 Webhook，定时任务/告警通知
# SOPHAGENT_DINGTALK_HOME_CHANNEL=          # 默认通知会话 ID
# SOPHAGENT_DINGTALK_REPLY_EMOTION=true     # 入站 🤔Thinking → 🥳Done 表情

# Tuning
#SOPHAGENT_MAX_CONCURRENT_TURNS=32
#SOPHAGENT_DELEGATE_CONCURRENCY=4
#SOPHAGENT_TOKEN_TTL_HOURS=24

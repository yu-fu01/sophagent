# --- auth -------------------------------------------------------------------
# JWT signing secret; if unset, one is generated and persisted in /data/.secret
SOPHAGENT_SECRET=

# Bootstrap admin account (created on first start when no users exist).
# If ADMIN_PASSWORD is unset a random password is generated and logged once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- model providers ----------------------------------------------------------
# RECOMMENDED: put a providers.yaml in the data dir instead (see README).
# Inline JSON below only works when passed without shell sourcing (e.g. via
# docker compose `environment:`); `source .env` strips the double quotes.
# api_key supports $ENV_NAME indirection.
SOPHAGENT_PROVIDERS={"providers":{"openai":{"api_mode":"openai","api_key":"$OPENAI_API_KEY","context_limit":128000},"anthropic":{"api_mode":"anthropic","api_key":"$ANTHROPIC_API_KEY","context_limit":200000}}}
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- optional ------------------------------------------------------------------
# Use a pre-built image from CI instead of local build (docker compose pull && up -d)
# SOPHAGENT_IMAGE=docker.fuyucloud.top/sophagent:dev-<sha>
# Better web_search backend (otherwise DuckDuckGo HTML fallback is used)
TAVILY_API_KEY=

# --- speech-to-text (Feishu / IM voice) --------------------------------------
# 默认走 Sophnet EasyLLM ASR（Fun-ASR）。留空 BASE_URL 即可，与聊天 provider 共用 API Key。
# SOPHAGENT_STT_API_KEY=           # 不填则自动用 providers.yaml 里 sophnet provider 的 key
# SOPHAGENT_STT_BASE_URL=          # 留空 = https://www.sophnet.com/.../easyllms/speechtotext
# SOPHAGENT_STT_MODEL=Fun-ASR
# Tuning
#SOPHAGENT_MAX_CONCURRENT_TURNS=32
#SOPHAGENT_DELEGATE_CONCURRENCY=4
#SOPHAGENT_TOKEN_TTL_HOURS=24
